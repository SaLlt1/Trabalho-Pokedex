# Banco de dados (fica no mesmo computador da API)
DB_HOST=localhost
DB_PORT=3306
DB_USER=uc33_app
DB_PASSWORD=troque_esta_senha
DB_NAME=pokemon_uc33

# Servidor
PORT=3000
# localhost: só este computador acessa. 0.0.0.0: qualquer computador da rede acessa.
HOST=localhost

# Front-ends que podem chamar a API pelo navegador, separados por vírgula
CORS_ORIGENS=http://localhost:5500,http://127.0.0.1:5500

# PokéAPI. Sem internet, use o simulador (npm run pokeapi:simulador) e troque para http://localhost:3005
POKEAPI_URL=https://pokeapi.co
POKEAPI_TEMPO_LIMITE_MS=3000
